{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HereWord",
  "version": "2.1.1-beta.26",
  "identifier": "com.tylertools.kokoro-voice-2-1",
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI5RTg3RDdBMDEzMkFGNjIKUldSaXJ6SUJlbjNvS2NaR3ZBdXJlY1JvLzJ3VEhTVFRXTkRwSEpBQ1kzNVJaLzRjTGI1OEJsMUsK"
    }
  },
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "url": "index.html",
        "title": "HereWord",
        "width": 620,
        "height": 780,
        "resizable": true,
        "visible": false
      },
      {
        "label": "player",
        "url": "player.html",
        "title": "Playing",
        "width": 152,
        "height": 50,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "shadow": false,
        "focus": false,
        "focusable": false,
        "visibleOnAllWorkspaces": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:8125; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "entitlements": "Entitlements.plist"
    },
    "resources": {
      "../../server.py": "engine-src/server.py",
      "../../stt_config.py": "engine-src/stt_config.py",
      "../../stt_worker.py": "engine-src/stt_worker.py",
      "../../stt_worker_manager.py": "engine-src/stt_worker_manager.py",
      "../../tts_engine.py": "engine-src/tts_engine.py",
      "../../tts_worker.py": "engine-src/tts_worker.py",
      "../../tts_worker_manager.py": "engine-src/tts_worker_manager.py",
      "../../benchmark_stt.py": "engine-src/benchmark_stt.py",
      "../../requirements.txt": "engine-src/requirements.txt",
      "../../requirements-macos.txt": "engine-src/requirements-macos.txt",
      "../../requirements-windows.txt": "engine-src/requirements-windows.txt",
      "../../requirements-macos.lock": "engine-src/requirements-macos.lock",
      "../../requirements-windows.lock": "engine-src/requirements-windows.lock",
      "../../client/*.py": "engine-src/client/",
      "../../scripts/release/release_manager.py": "release-manager.py"
    }
  }
}
